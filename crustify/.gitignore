# Example <repo>/crustify/.gitignore.

tmp
.worktrees
# Prebuilt variants of the target (see build.json).
builds
rust/target
rust.bak

# Campaign plans, the tasks written from them, and each agent's session and usage
# records are tracked: the usage records are the evidence behind dashboard.md's cost
# cells. The transcripts they are derived from live in crustify's home, outside the
# checkout.

# Review reproducers are tracked; the cargo trees their builds leave are not.
reviews/**/target

bak
stats.md
evaluation/**/manifests/

# Wavefront-owned CodeQL database/tables and disposable caches.
wavefront/codeql
wavefront/.cache

# Left by the campaign's earlier layout. The provider home now lives in crustify's
# home, and session records replace the agents' streams; neither is tracked.
.providers
artifacts/**/binder.log
artifacts/**/translator.log
artifacts/**/reviewer.log
